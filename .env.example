# Copy to .env. Never commit .env.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# gpt-oss-120b is text only, so images go to a separate vision model.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
SERP_API_KEY=

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. The default is the SQLite file backend/data/tilebuddy.db.
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/tilebuddy.db

# Optional agent limits. Defaults are in backend/app/config.py.
# AGENT_MAX_ORDER_VALUE_INR=500000
# AGENT_MAX_ORDERS_PER_DAY=5
